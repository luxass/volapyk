{
  "name": "volapyk",
  "version": "2.1.0",
  "description": "Generate random and meaningless blocks or sequences",
  "type": "module",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "packageManager": "pnpm@12.19.0",
  "license": "MIT",
  "homepage": "https://github.com/luxass/volapyk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/volapyk.git"
  },
  "bugs": {
    "url": "https://github.com/luxass/volapyk/issues"
  },
  "keywords": [
    "volapyk",
    "volapyk-generator",
    "random words",
    "random texts"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vitest",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  }
}
